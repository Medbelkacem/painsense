# Copy to .env at the repository root and replace every value before running outside a
# local machine. Docker Compose reads this file, and so does the backend.
#
# A backend started from backend/ also reads backend/.env, which takes precedence. That is
# what to use when the local database is keyed differently from the container stack: a
# master key should not be shared between environments, and swapping one makes the records
# sealed under the other unreadable.

DATABASE_URL=postgresql+psycopg://painscore:painscore@localhost:5432/painscore
# Local run without PostgreSQL:
# DATABASE_URL=sqlite+pysqlite:///./painscore.db

# 32 random bytes, base64. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL_MINUTES=20
REFRESH_TOKEN_TTL_DAYS=14

# Directories created on first start if absent. The keystore holds the ledger signing
# keys, so keep it off any shared volume.
KEY_STORE_PATH=./keystore
MODEL_STORE_PATH=./models
DATASET_PATH=./datasets
DOCUMENT_STORE_PATH=./storage/documents

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Largest medical document accepted, in bytes.
MAX_DOCUMENT_BYTES=15728640

# Set to production to refuse startup when a secret above is left empty.
# Anywhere else, missing secrets are replaced by random per-process values.
PAINSCORE_ENV=development

# Used by docker compose only. Leave the bootstrap pair empty to skip creating an account.
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
