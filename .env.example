DATABASE_URL=postgresql+psycopg://painscore:painscore@localhost:5432/painscore

MASTER_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL_MINUTES=20
REFRESH_TOKEN_TTL_DAYS=14

KEY_STORE_PATH=./keystore
MODEL_STORE_PATH=./models
DATASET_PATH=./datasets
DOCUMENT_STORE_PATH=./storage/documents
EXTERNAL_DATASET_PATH=./storage/external
SIGNAL_STORE_PATH=./storage/signals
EPIDEMIC_DATA_PATH=./data

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

MAX_DOCUMENT_BYTES=15728640

PAINSCORE_ENV=development

# External dataset synchronisation.
# SYNC_AUTO_ACQUIRE=false catalogues what publishers list without downloading anything,
# which is the right setting while reviewing which licences this deployment accepts.
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=360
SYNC_AUTO_ACQUIRE=true
SYNC_AUTO_TRAIN=true
SYNC_MAX_DATASET_BYTES=268435456
SYNC_MAX_ACQUISITIONS_PER_RUN=3
SYNC_REQUEST_TIMEOUT_SECONDS=60

# Kaggle's documented API. Leave blank to search anonymously, which works for discovery
# and for downloading datasets whose owners do not require a signed-in account.
# Create a token at https://www.kaggle.com/settings -> API -> Create New Token.
KAGGLE_USERNAME=
KAGGLE_KEY=

POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
